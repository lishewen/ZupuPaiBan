<Window x:Class="ZupuPaiBan.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ZupuPaiBan.Models"
        mc:Ignorable="d"
        Title="排版预览与打印" Height="750" Width="1200"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <ToolBar Grid.Row="0" Background="#F5F0E8">
            <Button Command="{Binding PrintCommand}" Padding="8,4" Margin="2"
                    Background="#4A7AB5" Foreground="White" FontWeight="Bold">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🖨️" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" 打印" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ExportXpsCommand}" Padding="8,4" Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" 导出XPS" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ZoomOutCommand}" Padding="6,4" Margin="2" Content="➖"/>
            <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" VerticalAlignment="Center"
                       Width="50" TextAlignment="Center"/>
            <Button Command="{Binding ZoomInCommand}" Padding="6,4" Margin="2" Content="➕"/>
            <Button Command="{Binding ZoomFitCommand}" Padding="6,4" Margin="2" Content="1:1"/>
            <Separator/>
            <Button Command="{Binding RefreshPreviewCommand}" Padding="8,4" Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" 刷新" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding FirstPageCommand}" Padding="4,4" Margin="2" Content="⏮" ToolTip="首页"/>
            <Button Command="{Binding PreviousPageCommand}" Padding="4,4" Margin="2" Content="◀" ToolTip="上一页"/>
            <TextBlock VerticalAlignment="Center" Margin="5,0">
                <Run Text="第"/>
                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                <Run Text="/"/>
                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                <Run Text="页"/>
            </TextBlock>
            <Button Command="{Binding NextPageCommand}" Padding="4,4" Margin="2" Content="▶" ToolTip="下一页"/>
            <Button Command="{Binding LastPageCommand}" Padding="4,4" Margin="2" Content="⏭" ToolTip="末页"/>
        </ToolBar>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- 预览区域 (ScrollViewer + 缩放) -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" Background="#E0E0E0"
                          x:Name="scrollViewer">
                <Border Background="White" BorderBrush="#999" BorderThickness="1"
                        Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top"
                        x:Name="pageBorder">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                    </Border.Effect>
                    <ContentControl x:Name="previewHost"
                                    Content="{Binding PreviewContent}"/>
                </Border>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" Background="#DDD" HorizontalAlignment="Stretch"/>

            <!-- 右侧：排版设置面板 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Background="#FAFAF5">
                <StackPanel Margin="10">
                    <TextBlock Text="排版设置" FontWeight="Bold" FontSize="16"
                               Foreground="#8B5E3C" Margin="0,0,0,15"/>

                    <!-- 标题 -->
                    <TextBlock Text="族谱标题" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Settings.Title, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3" Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Text="标题字号" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <Slider Value="{Binding Settings.TitleFontSize}" Minimum="16" Maximum="48"
                            TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding Settings.TitleFontSize, StringFormat='{}{0:F0} pt'}"
                               FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>

                    <!-- 纸张设置 -->
                    <TextBlock Text="纸张大小" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <ComboBox SelectedValue="{Binding Settings.PageSize}" Margin="0,0,0,10" Padding="4,3">
                        <x:Static Member="models:PageSizeOption.A2"/>
                        <x:Static Member="models:PageSizeOption.A3"/>
                        <x:Static Member="models:PageSizeOption.A4"/>
                    </ComboBox>

                    <TextBlock Text="纸张方向" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <ComboBox SelectedValue="{Binding Settings.Orientation}" Margin="0,0,0,10" Padding="4,3">
                        <x:Static Member="models:PageOrientation.Landscape"/>
                        <x:Static Member="models:PageOrientation.Portrait"/>
                    </ComboBox>

                    <Separator Margin="0,5"/>

                    <!-- 节点设置 -->
                    <TextBlock Text="节点设置" FontWeight="Bold" FontSize="14"
                               Foreground="#8B5E3C" Margin="0,10,0,10"/>

                    <TextBlock Text="节点宽度" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <Slider Value="{Binding Settings.NodeWidth}" Minimum="80" Maximum="250"
                            TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding Settings.NodeWidth, StringFormat='{}{0:F0} px'}"
                               FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>

                    <TextBlock Text="节点高度" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <Slider Value="{Binding Settings.NodeHeight}" Minimum="60" Maximum="200"
                            TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding Settings.NodeHeight, StringFormat='{}{0:F0} px'}"
                               FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>

                    <TextBlock Text="水平间距" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <Slider Value="{Binding Settings.HorizontalSpacing}" Minimum="10" Maximum="100"
                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding Settings.HorizontalSpacing, StringFormat='{}{0:F0} px'}"
                               FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>

                    <TextBlock Text="垂直间距" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <Slider Value="{Binding Settings.VerticalSpacing}" Minimum="30" Maximum="200"
                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding Settings.VerticalSpacing, StringFormat='{}{0:F0} px'}"
                               FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>

                    <TextBlock Text="字体大小" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <Slider Value="{Binding Settings.FontSize}" Minimum="8" Maximum="24"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding Settings.FontSize, StringFormat='{}{0:F0} pt'}"
                               FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>

                    <Separator Margin="0,5"/>

                    <!-- 显示选项 -->
                    <TextBlock Text="显示选项" FontWeight="Bold" FontSize="14"
                               Foreground="#8B5E3C" Margin="0,10,0,10"/>

                    <CheckBox Content="显示照片" IsChecked="{Binding Settings.ShowPhoto}"
                              Margin="0,0,0,6"/>
                    <CheckBox Content="显示配偶" IsChecked="{Binding Settings.ShowSpouse}"
                              Margin="0,0,0,6"/>
                    <CheckBox Content="显示生平简介" IsChecked="{Binding Settings.ShowBiography}"
                              Margin="0,0,0,6"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Background="#F5F0E8">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
