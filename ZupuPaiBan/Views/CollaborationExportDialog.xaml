<Window x:Class="ZupuPaiBan.Views.CollaborationExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="协作导出" Height="400" Width="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择要导出的成员（将导出其所有后代）：" FontWeight="Bold" Margin="0,0,0,8"/>
        
        <TreeView Grid.Row="1" x:Name="treeMembers" BorderBrush="#CCC" BorderThickness="1"
                  SelectedItemChanged="TreeMembers_SelectedItemChanged"/>

        <Border Grid.Row="2" Background="#F9F9F0" Padding="8" Margin="0,8,0,8" CornerRadius="3">
            <TextBlock x:Name="txtInfo" Text="请在上方选择一位成员" Foreground="Gray"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnExport" Content="导出" Click="BtnExport_Click" 
                    Padding="20,6" Margin="5,0" IsEnabled="False"
                    Background="#4A7AB5" Foreground="White" FontWeight="Bold"/>
            <Button Content="取消" Click="BtnCancel_Click" Padding="15,6" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
